# Local real-key template. Copy this file to `.env.local` or `.env` and fill your real key.
# Never commit `.env`, `.env.local`, or any file containing an actual API key.
LONGCAT_API_KEY=replace_with_your_real_longcat_api_key
LONGCAT_BASE_URL=https://api.longcat.chat
LONGCAT_MODEL=LongCat-Flash-Chat
LONGCAT_TIMEOUT_SECONDS=20
NEARNOW_PROVIDER_MODE=real
NEARNOW_STORAGE_BACKEND=memory
NEARNOW_MYSQL_AUTO_MIGRATE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nearnow
MYSQL_USER=nearnow
MYSQL_PASSWORD=replace_with_your_mysql_password
