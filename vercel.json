{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "cd web && npm ci && npm run build",
    "functions": {
        "app/main.py": {
            "includeFiles": "web/dist/**",
            "excludeFiles": "{tests/**,web/node_modules/**,web/src/**,web-legacy/**,.pytest_cache/**}"
        }
    }
}