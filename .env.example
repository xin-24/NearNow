# GitHub-safe example. Do not put a real API key in this file.
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat
LONGCAT_MODEL=LongCat-Flash-Chat
LONGCAT_TIMEOUT_SECONDS=20
NEARNOW_PROVIDER_MODE=real
NEARNOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEARNOW_LOG_LEVEL=INFO
NEARNOW_COOKIE_SECURE=false
NEARNOW_STORAGE_BACKEND=memory
NEARNOW_MYSQL_AUTO_MIGRATE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nearnow
MYSQL_USER=nearnow
MYSQL_PASSWORD=
